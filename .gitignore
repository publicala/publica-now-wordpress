# Dependencies (dev tooling only; the shipped plugin has no vendor/ or node_modules/)
/vendor/
/node_modules/

# Build output: bin/build-zip.sh writes dist/publica-now/ and dist/publica-now-{version}.zip
/dist/

# Lock files ARE committed. The toolchain is dev-only, but CI runs `npm ci`
# and `composer install`, both of which require a lockfile and fail without
# one. Committing them also pins the versions that produced a green run, so a
# gate cannot start failing because an upstream release moved underneath it.
# Neither file ships: .distignore keeps both out of the plugin zip.

# Tool caches
/.phpcs-cache
/.phpunit.result.cache

# Local wp-env overrides (ports, PHP version, extra plugins) stay on each machine
/.wp-env.override.json

# Compiled translations are served by translate.wordpress.org, never committed
/languages/*.mo
/languages/*.po
/languages/*.json

# Editors and agents
/.idea/
/.vscode/
/.claude/settings.local.json
/.gstack/
*.swp
*~

# Operating systems
.DS_Store
Thumbs.db

# Logs
*.log
